<style>
/* NDE house style for Bikeshed specifications, from netwerk-digitaal-erfgoed/workflows.
   Rules sit inside :where() where they can, so any rule of Bikeshed’s or the spec’s wins. */

.head [data-fill-with="logo"] {
    float: right;
    margin: 0 0 1em 1em;
}
.head .nde-logo {
    display: block;
    border: none;
}
/* Bikeshed gives every svg a white background. */
.head .nde-logo svg {
    background: none;
}
/* The NDE logo manual: the blue logo on light backgrounds. In dark mode the
   logo takes the page’s text colour: white on Bikeshed’s dark background, or
   black (the manual’s black logo) in a spec that sets ‘Dark Mode: off’. */
.nde-logo-mark {
    fill: #0a3dfa;
}
.nde-logo-wordmark {
    fill: #231f20;
}
@media (prefers-color-scheme: dark) {
    .nde-logo-mark,
    .nde-logo-wordmark {
        fill: var(--text);
    }
}

/* Tables in the spec’s own content: striped rows, and code that wraps instead of widening a column. */
:where(main table) {
    border-collapse: collapse;
}
:where(main table th, main table td) {
    padding: 0.5em 0.75em;
    text-align: left;
    vertical-align: top;
}
:where(main table thead th) {
    border-bottom: 2px solid var(--text);
}
:where(main table tbody tr:nth-child(even)) {
    background: var(--tocsidebar-bg);
}
:where(main table code) {
    overflow-wrap: anywhere;
}
</style>
