{%- comment -%}
    Renders the Cardinality and Usage cells of one attribute table row, for the
    property shape `property` of the node shape `nodeShape`. `property` is the
    row’s shape, which may merge several shapes on one path; whether it is
    required comes from the node shape, which also holds any sh:or of which one
    property is required. An nde:futureChange adds what changes in which version.
    A property with an sh:minCount of severity sh:Warning is Recommended; one
    without any sh:minCount gets the `optional` label, by default Optional.
    `iri` is the spec’s word for an identifier, by default IRI. With `combined`,
    one Usage cell also says how many values are allowed, in words, and a change
    to what the values must be is left out of it. Render this partial again with
    `part: 'value-note'` to get only that change, to show next to the expected value.
{%- endcomment -%}
{%- assign iri = iri | default: "IRI" -%}
{%- assign label_lang = lang | default: "en" -%}
{%- assign alternatives = '' -%}
{%- for or_list in nodeShape.or -%}
    {%- assign or_paths = or_list | map: 'property' | map: 'path' -%}
    {%- if or_paths contains property.path -%}
        {%- assign alternatives = or_paths -%}
    {%- endif -%}
{%- endfor -%}
{%- comment -%}
    The merged row takes each key from the first shape on the path that has it,
    so its severity can belong to a sibling (such as a langString warning).
    Whether the property is required comes from the shape with the sh:minCount.
{%- endcomment -%}
{%- assign requirement = nil -%}
{%- for shape in nodeShape.property -%}
    {%- if shape.path == property.path and shape.minCount > 0 -%}
        {%- assign requirement = shape -%}
        {%- break -%}
    {%- endif -%}
{%- endfor -%}
{%- assign is_enforced = false -%}
{%- assign becomes_required = false -%}
{%- if requirement -%}
    {%- assign requirement_severity = requirement.severity | default: "Violation" -%}
    {%- if requirement_severity == "Violation" -%}
        {%- assign is_enforced = true -%}
    {%- elsif requirement['nde:futureChange'].severity == "Violation" -%}
        {%- assign becomes_required = true -%}
    {%- endif -%}
{%- endif -%}
{%- assign pattern_str = property.pattern | default: "" -%}
{%- assign is_date_shape = pattern_str contains "[0-9]{4}" -%}
    {%- assign cardinality_note = '' -%}
    {%- assign count_note = '' -%}
    {%- assign min_count = 0 -%}
    {%- if is_enforced and alternatives == '' -%}{%- assign min_count = requirement.minCount -%}{%- endif -%}
    {%- assign current_min = min_count | default: 0 -%}
    {%- assign current_max = property.maxCount | default: "n" -%}
    {%- if property.maxCount == 0 -%}
        {%- assign current_card = "0" -%}
    {%- elsif min_count and min_count == property.maxCount -%}
        {%- capture current_card %}{{ min_count }}{% endcapture -%}
    {%- else -%}
        {%- capture current_card %}{{ current_min }}..{{ current_max }}{% endcapture -%}
    {%- endif -%}
    {%- if property['nde:futureChange'] -%}
        {%- assign change = property['nde:futureChange'] -%}
        {%- capture version_link %}<a href="#v{{ change['nde:version'] | split: '.' | first }}">v{{ change['nde:version'] }}</a>{% endcapture -%}
        {%- assign future_min = current_min -%}
        {%- assign future_max = current_max -%}
        {%- if change.minCount -%}{%- assign future_min = change.minCount -%}{%- endif -%}
        {%- if change.maxCount -%}{%- assign future_max = change.maxCount -%}{%- endif -%}
        {%- if becomes_required -%}{%- assign future_min = requirement.minCount -%}{%- endif -%}
        {%- if change.severity == "Violation" and current_min == 0 and property.maxCount != 0 -%}
            {%- unless change.datatype or change.pattern or change.nodeKind or property.datatype or property.pattern or property.nodeKind or property.or or property.not or property.node.pattern -%}
                {%- assign future_min = 1 -%}
            {%- endunless -%}
        {%- endif -%}
        {%- if future_max == 0 -%}
            {%- assign future_card = "0" -%}
        {%- elsif future_min == future_max -%}
            {%- capture future_card %}{{ future_min }}{% endcapture -%}
        {%- else -%}
            {%- capture future_card %}{{ future_min }}..{{ future_max }}{% endcapture -%}
        {%- endif -%}
        {%- if future_card != current_card -%}
            {%- capture future_count %}{% render 'nde-value-count', min: future_min, max: future_max, uniqueLang: property.uniqueLang %}{% endcapture -%}
            {%- capture cardinality_note %}<br><small>{{ version_link }}: {{ future_card }}</small>{% endcapture -%}
            {%- capture count_note %}<br><small>{{ version_link }}: {{ future_count }}</small>{% endcapture -%}
        {%- endif -%}
    {%- endif -%}
    {% assign is_required = false -%}
    {% capture usage_label -%}
    {% if property.maxCount == 0 -%}
        Discouraged
    {% elsif alternatives != '' -%}
        Required: {{ alternatives | join: ' or ' }}
        {% assign is_required = true -%}
    {% elsif is_enforced -%}
        Required
        {% assign is_required = true -%}
    {% elsif requirement -%}
        Recommended
    {% else -%}
        {{ optional | default: "Optional" }}
    {% endif -%}
    {% endcapture -%}
    {% assign usage_label = usage_label | strip -%}
    {% assign usage_note = '' -%}
    {% assign value_note = '' -%}
    {% if property['nde:futureChange'] -%}
        {% assign change = property['nde:futureChange'] -%}
        {% assign future_text = "" -%}
        {% assign usage_change = false -%}
        {% if change.datatype -%}
            {% assign future_text = change.datatype | replace: 'http://www.w3.org/2001/XMLSchema#', 'xsd:' | prepend: 'must be ' -%}
        {% elsif change.pattern -%}
            {% capture future_text %}must match <code>{{ change.pattern }}</code>{% endcapture -%}
        {% elsif change.nodeKind == "IRI" and change.severity != "Violation" -%}
            {% assign future_text = iri | prepend: "must be " -%}
        {% elsif change.maxCount -%}
            {% assign future_text = change.maxCount | prepend: "max " -%}
            {% assign usage_change = true -%}
        {% elsif change.severity == "Violation" and property.maxCount == 0 -%}
            {% assign future_text = "no longer allowed" -%}
            {% assign usage_change = true -%}
        {% elsif change.severity == "Violation" and property.nodeKind == "IRI" -%}
            {% assign future_text = iri | prepend: "must be " -%}
        {% elsif change.severity == "Violation" and property.datatype -%}
            {% assign future_text = property.datatype | replace: 'http://www.w3.org/2001/XMLSchema#', 'xsd:' | replace: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#', 'rdf:' | prepend: 'must be ' -%}
        {% elsif change.severity == "Violation" and property.node.pattern -%}
            {% capture future_text %}must match <code>{{ property.node.pattern }}</code>{% endcapture -%}
        {% elsif change.severity == "Violation" and is_date_shape -%}
            {% assign future_text = "must be valid ISO 8601" -%}
        {% elsif change.severity == "Violation" and property.uniqueLang -%}
            {% assign future_text = "max one value per language" -%}
            {% assign usage_change = true -%}
        {% elsif change.severity == "Violation" and property.or -%}
            {%- assign has_iri_alt = false -%}
            {%- assign has_date_alt = false -%}
            {%- for or_list in property.or -%}
                {%- for alt in or_list -%}
                    {%- if alt.nodeKind == "IRI" -%}{%- assign has_iri_alt = true -%}{%- endif -%}
                    {%- assign alt_pattern = alt.pattern | default: "" -%}
                    {%- if alt_pattern contains "{4" -%}{%- assign has_date_alt = true -%}{%- endif -%}
                {%- endfor -%}
            {%- endfor -%}
            {%- if has_iri_alt and has_date_alt -%}
                {% assign future_text = iri | prepend: "must be valid ISO 8601 or " -%}
            {%- endif -%}
        {% elsif change.severity == "Violation" and property.not.pattern and change['rdfs:label'] == nil -%}
            {%- assign not_pattern = property.not.pattern -%}
            {%- if not_pattern contains "https?" or not_pattern contains "http" -%}
                {% assign future_text = iri | append: "s not allowed" -%}
            {%- endif -%}
        {% endif -%}
        {% assign value_text = future_text -%}
        {% if usage_change -%}{% assign value_text = "" -%}{% endif -%}
        {%- comment -%}
            The row keeps the nde:futureChange of one shape only, while a path can have
            several, each in a shape of its own. A change that its constraint can’t
            describe, such as an sh:not rule, names itself in rdfs:label: add the label
            of every such change on the path, and an sh:maxCount that only gets stricter.
        {%- endcomment -%}
        {%- for shape in nodeShape.property -%}
            {%- if shape.path != property.path or shape['nde:futureChange'] == nil -%}{%- continue -%}{%- endif -%}
            {%- assign shape_change = shape['nde:futureChange'] -%}
            {%- assign change_label = shape_change['rdfs:label'] | lang: label_lang -%}
            {%- if change_label != "" and change_label != nil -%}
                {%- unless value_text contains change_label -%}
                    {%- if value_text == "" -%}{%- assign value_text = change_label -%}{%- else -%}{%- assign value_text = value_text | append: "; " | append: change_label -%}{%- endif -%}
                    {%- if future_text == "" -%}{%- assign future_text = change_label -%}{%- else -%}{%- assign future_text = future_text | append: "; " | append: change_label -%}{%- endif -%}
                {%- endunless -%}
            {%- elsif shape_change.severity == "Violation" and shape.maxCount and shape.maxCount != 0 and shape.minCount == nil and becomes_required != true -%}
                {%- comment -%} When the property becomes required, the cardinality already shows its maximum. {%- endcomment -%}
                {%- assign max_label = shape.maxCount | prepend: "max " -%}
                {%- unless future_text contains max_label -%}
                    {%- if future_text == "" -%}{%- assign future_text = max_label -%}{%- else -%}{%- assign future_text = future_text | append: "; " | append: max_label -%}{%- endif -%}
                {%- endunless -%}
            {%- endif -%}
        {%- endfor -%}
        {% if becomes_required -%}
            {% if future_text == "" -%}
                {% assign future_text = "becomes required" -%}
            {% elsif future_text != "becomes required" -%}
                {% assign future_text = future_text | prepend: "becomes required; " -%}
            {% endif -%}
        {% endif -%}
        {% if future_text == "" and change.severity == "Violation" and is_required == false and property.maxCount != 0 -%}
            {% assign future_text = "becomes required" -%}
        {% endif -%}
        {% if value_text != "" -%}
            {% capture value_note %}<br><small>{{ version_link }}: {{ value_text }}</small>{% endcapture -%}
            {% if combined -%}
                {% assign future_text = "" -%}
                {% if becomes_required -%}{% assign future_text = "becomes required" -%}{% endif -%}
            {% endif -%}
        {% endif -%}
        {% if future_text != "" -%}
            {% capture usage_note %}<br><small>{{ version_link }}: {{ future_text }}</small>{% endcapture -%}
        {% endif -%}
    {% endif -%}
{%- if part == 'value-note' -%}
    {{- value_note -}}
{%- elsif combined -%}
    {%- comment -%} One cell: the usage with how many values, in words, and one note on what changes. {%- endcomment -%}
    {%- assign count = '' -%}
    {%- unless property.maxCount == 0 or alternatives != '' -%}
        {%- capture count %}{% render 'nde-value-count', min: current_min, max: property.maxCount, uniqueLang: property.uniqueLang %}{% endcapture -%}
    {%- endunless -%}
    {%- if usage_note == '' -%}{%- assign usage_note = count_note -%}{%- endif -%}
    <td>{{ usage_label }}{% if count != '' %}, {{ count }}{% endif %}{{ usage_note }}</td>
{%- else -%}
    <td>{{ current_card }}{{ cardinality_note }}</td>
    <td>{{ usage_label }}{{ usage_note }}</td>
{%- endif -%}
